# Variables utilisées par docker compose (copier en .env et adapter par client)

POSTGRES_USER=netwatch
POSTGRES_PASSWORD=changez-ce-mot-de-passe
POSTGRES_DB=netwatch

# Port exposé sur la machine hôte
APP_PORT=3001

# `http` = interroger le collecteur (service `collector`), `demo` = réseau fictif intégré à l'API
SCANNER_MODE=http
SCANNER_URL=http://collector:8080
SCANNER_TOKEN=

# Scanner Python : port exposé sur la machine hôte, durée max d'un scan (ms)
COLLECTOR_PORT=8090
SCANNER_TIMEOUT_MS=120000

# Cibles scannées par POST /scan (IP, noms ou CIDR, séparés par des virgules)
SCANNER_TARGETS=192.168.10.0/24
# Services TCP à surveiller (facultatif) : JSON [{"ip":"...","port":80}]
# SCANNER_TCP_TARGETS=[]
# Métriques CPU/RAM/disques par SSH (facultatif)
# NETWATCH_SSH_USER=
# NETWATCH_SSH_PASSWORD=

# Collecteur Python (docker-compose.collector-python.yml) : image à utiliser
# COLLECTOR_IMAGE=registre/netwatch-collector:1.0
