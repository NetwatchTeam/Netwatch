# Variables utilisées par docker compose (copier en .env et adapter par client)

POSTGRES_USER=netwatch
POSTGRES_PASSWORD=changez-ce-mot-de-passe
POSTGRES_DB=netwatch

# Port exposé sur la machine hôte
APP_PORT=3001

# Accès au tableau de bord (verrou provisoire : un seul mot de passe partagé)
APP_PASSWORD=changez-ce-mot-de-passe
# À régénérer pour chaque installation : openssl rand -base64 48
SESSION_SECRET=remplacez-par-au-moins-32-caracteres-aleatoires

# `demo` = réseau fictif intégré, `http` = vrai scanner
SCANNER_MODE=demo
SCANNER_URL=http://scanner:8080
SCANNER_TOKEN=
