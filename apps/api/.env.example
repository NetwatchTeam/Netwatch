# Base de données
DATABASE_URL=postgres://netwatch:netwatch@localhost:5432/netwatch

# Port d'écoute de l'API
PORT=3001

# Scanner : `demo` génère un réseau fictif, `http` interroge le vrai scanner
SCANNER_MODE=demo
SCANNER_URL=http://localhost:8080
SCANNER_TOKEN=
SCANNER_TIMEOUT_MS=15000

# Accès au tableau de bord (verrou provisoire : un seul mot de passe partagé)
APP_PASSWORD=changez-ce-mot-de-passe
# Clé de signature des sessions : au moins 32 caractères, à générer par client
SESSION_SECRET=remplacez-par-32-caracteres-aleatoires-minimum
SESSION_TTL_HOURS=12

# Interface servie séparément en développement (port Vite)
CORS_ORIGIN=http://localhost:5173
# En production, l'API sert l'interface compilée :
# WEB_DIST_PATH=/app/web
