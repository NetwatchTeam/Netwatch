# Configuration de l'API pour `npm run dev` (copier en apps/api/.env).
# Les valeurs ci-dessous correspondent à la base et au collecteur lancés par :
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --no-deps db collector
# Pour essayer sans base ni collecteur : `npm run dev:demo` (voir apps/api/.env.demo).

# Base de données : même utilisateur et même mot de passe que POSTGRES_USER / POSTGRES_PASSWORD
# du fichier .env à la racine ; port 5433 (docker-compose.dev.yml)
DATABASE_URL=postgres://netwatch:changez-ce-mot-de-passe@localhost:5433/netwatch

# Port d'écoute de l'API
PORT=3001

# Collecteur : `http` interroge le collecteur (simulé : port 8090), `demo` génère un réseau fictif
SCANNER_MODE=http
SCANNER_URL=http://localhost:8090
SCANNER_TOKEN=
SCANNER_TIMEOUT_MS=15000

# Fuseau des heures affichées dans le rapport PDF
REPORT_TIME_ZONE=Europe/Paris

# Interface servie séparément en développement (port Vite)
CORS_ORIGIN=http://localhost:5173
# En production, l'API sert l'interface compilée :
# WEB_DIST_PATH=/app/web
