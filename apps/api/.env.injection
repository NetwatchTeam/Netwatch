# Configuration de `npm run dev:injection` : l'API sans base ni collecteur, alimentée uniquement par
# les jeux de données fictifs injectés avec `npm run scan:inject -- <scénario>` (aucun scan automatique).
# Les données sont perdues à chaque arrêt. Versionné volontairement : ne contient aucun secret.
PORT=3001
STORAGE=memory
SCANNER_MODE=none
SCAN_IMPORT=enabled
CORS_ORIGIN=http://localhost:5173
